{
  "name": "lushan-war-culture-visualization",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "preview": "vite preview --host 127.0.0.1",
    "server:dev": "tsx --tsconfig server/tsconfig.json server/src/main.ts",
    "server:start": "tsx --tsconfig server/tsconfig.json server/src/main.ts",
    "server:deploy:init": "node server/scripts/init-production.mjs",
    "server:seed": "prisma generate --schema server/prisma/schema.prisma && prisma db push --schema server/prisma/schema.prisma && tsx --tsconfig server/tsconfig.json server/prisma/seed.ts",
    "server:generate": "prisma generate --schema server/prisma/schema.prisma",
    "server:studio": "prisma studio --schema server/prisma/schema.prisma"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.21",
    "@nestjs/core": "^11.1.21",
    "@nestjs/platform-express": "^11.1.21",
    "@prisma/client": "^6.19.3",
    "@vitejs/plugin-react": "^5.0.0",
    "lucide-react": "^1.33.0",
    "mapbox-gl": "^3.24.0",
    "pg": "^8.23.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.21",
    "playwright": "^1.60.0",
    "postcss": "^8.5.6",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.22.3",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  }
}
