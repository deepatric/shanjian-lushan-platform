FROM node:22-bookworm-slim

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --include=dev

COPY server ./server
COPY public/assets/places ./public/assets/places

RUN npm run server:generate

ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV PORT=4000

EXPOSE 4000

CMD ["sh", "-c", "npm run server:deploy:init && npm run server:start"]
